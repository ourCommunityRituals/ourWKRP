{
  "name": "ourwkrp",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first Spotify music catalog — auth, sync, discover, create",
  "scripts": {
    "dev": "doppler run -- wrangler dev",
    "dev:local": "wrangler dev",
    "preflight:staging": "node scripts/preflight-deploy.mjs",
    "preflight:prod": "node scripts/preflight-deploy.mjs production",
    "migrate:staging": "doppler run -p ourwkrp-deploy -c stg -- bash scripts/ci/wrangler-ci.sh stg d1 migrations apply ourwkrp-staging --remote",
    "migrate:prod": "doppler run -p ourwkrp-deploy -c prd -- bash scripts/ci/wrangler-ci.sh prd d1 migrations apply ourwkrp-production --remote --env production",
    "predeploy:staging": "npm run preflight:staging && npm run migrate:staging",
    "deploy:staging": "doppler run -p ourwkrp-deploy -c stg -- bash scripts/ci/wrangler-ci.sh stg deploy",
    "postdeploy:staging": "npm run smoke:staging",
    "predeploy:prod": "npm run preflight:prod && npm run migrate:prod",
    "deploy:prod": "doppler run -p ourwkrp-deploy -c prd -- bash scripts/ci/wrangler-ci.sh prd deploy --env production",
    "postdeploy:prod": "npm run smoke:prod",
    "deploy-keys": "node scripts/ops/rotate-deploy-keys.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:staging": "node scripts/smoke.mjs https://stg.ourwkrp.com",
    "smoke:prod": "node scripts/smoke.mjs https://ourwkrp.com",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:security": "vitest run tests/security",
    "test:fuzz": "vitest run tests/fuzz",
    "test:mutation": "stryker run",
    "test:mutation:schemas": "stryker run stryker.schemas.conf.mjs",
    "test:mutation:floor": "node scripts/ci/mutation-file-floor.mjs reports/mutation/mutation.json reports/mutation-schemas/mutation.json",
    "test:e2e": "node scripts/seed-local-d1.mjs && playwright test tests/e2e",
    "test:mobile-workability": "node scripts/seed-local-d1.mjs && playwright test tests/playwright",
    "test:performance": "vitest run tests/performance",
    "lint:showcase": "eslint showcase/",
    "test:showcase": "vitest run --config showcase/vitest.config.mjs",
    "test:showcase:security": "vitest run --config showcase/vitest.config.mjs showcase/tests/security.test.mjs",
    "test:showcase:contract": "vitest run --config showcase/vitest.config.mjs showcase/tests/contract.test.mjs",
    "test:showcase:unit": "vitest run --config showcase/vitest.config.mjs showcase/tests/unit.test.mjs",
    "test:showcase:born-red": "vitest run --config showcase/vitest.config.mjs showcase/tests/born-red.test.mjs",
    "test:showcase:e2e": "playwright test --config showcase/playwright.config.mjs",
    "test:load": "k6 run k6/sync-load.js",
    "db:seed:local": "node scripts/seed-local-d1.mjs",
    "test:bruno": "node scripts/seed-local-d1.mjs && node -e \"require('fs').mkdirSync('.test-results',{recursive:true})\" && start-server-and-test \"npx wrangler dev --port 8787 --var WKRP_ADMIN_TOKEN:bruno-admin-token\" http-get://localhost:8787/health \"cd bruno/wkrp-api && npx bru run . -r --env wkrp-local --reporter-junit ../../.test-results/bru-api-junit.xml\"",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "ci": "npm run typecheck && npm run lint && npm run test"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.0",
    "ws": "8.21.0",
    "@usebruno/cli": {
      "axios": "^1.20.0",
      "form-data": "^4.0.6",
      "js-yaml": "^4.3.2",
      "yaml": "^2.8.3",
      "uuid": "^11.1.1",
      "csv-parse": "^7.0.2",
      "@faker-js/faker": "^10.4.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20260930.2",
    "@eslint/js": "^9.5.0",
    "@playwright/test": "^1.45.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@usebruno/cli": "^4.1.0",
    "eslint": "^9.5.0",
    "fast-check": "^4.8.0",
    "js-yaml": "^4.3.2",
    "jsqr": "1.4.0",
    "miniflare": "^4.20260730.0",
    "start-server-and-test": "^3.0.5",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@ocr/ui": "file:../packages/ui",
    "zod": "^4.3.6"
  }
}
