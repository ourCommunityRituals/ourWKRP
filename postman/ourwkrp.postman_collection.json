{
  "info": {
    "_postman_id": "a1c2e3d4-5f6a-4b7c-8d9e-0f1a2b3c4d5e",
    "name": "ourWKRP - Core Flows",
    "description": "End-to-end smoke run of the ourWKRP core user journey: health, anonymous browse, register, session, CSV import, catalog, and playlist build. Each request asserts status and shape; later requests reuse the session cookie, contributor id, playlist id, and track ids captured by earlier ones. Run with Newman against a seeded `wrangler dev` instance (npm run test:postman) or import into the Postman app.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('service is ourwkrp and ok', function () {",
              "  pm.expect(body.ok).to.eql(true);",
              "  pm.expect(body.service).to.eql('ourwkrp');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "02 Anonymous catalog browse",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200 (no auth required to browse)', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('returns a tracks array', function () {",
              "  pm.expect(body.ok).to.eql(true);",
              "  pm.expect(body.tracks).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tracks"
      }
    },
    {
      "name": "03 Register contributor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "var body = pm.response.json();",
              "pm.test('contributor created with curator role', function () {",
              "  pm.expect(body.ok).to.eql(true);",
              "  pm.expect(body.contributor.role).to.eql('curator');",
              "});",
              "pm.collectionVariables.set('contributor_id', body.contributor.id);",
              "var setCookie = pm.response.headers.get('Set-Cookie');",
              "pm.test('session cookie issued', function () {",
              "  pm.expect(setCookie, 'Set-Cookie header').to.be.a('string');",
              "  pm.expect(setCookie).to.include('wkrp_session=');",
              "});",
              "pm.collectionVariables.set('session_cookie', String(setCookie).split(';')[0]);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Curator\",\n  \"role\": \"curator\",\n  \"generation\": \"gen2\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/auth/register"
      }
    },
    {
      "name": "04 Session - who am I",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('session resolves to the registered contributor', function () {",
              "  pm.expect(body.ok).to.eql(true);",
              "  pm.expect(body.contributor.id).to.eql(pm.collectionVariables.get('contributor_id'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Cookie", "value": "{{session_cookie}}" }
        ],
        "url": "{{base_url}}/auth/session/me"
      }
    },
    {
      "name": "05 Import library CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('4 contributions created with no errors', function () {",
              "  pm.expect(body.contributions_created).to.eql(4);",
              "  pm.expect(body.errors).to.be.an('array').that.is.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cookie", "value": "{{session_cookie}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"csv\":\"Track URI,Track Name,Artist Name(s),Album Name,ISRC,Album Release Date,Energy,Danceability,Valence,Artist Genres,Track Duration (ms)\\nspotify:track:4cOdK2wGLETKBW3PvgPWqT,Postman Track One,Postman Test Quartet,Smoke Test Sessions,USPM00000001,2022-05-01,0.61,0.74,0.52,test-jazz,201000\\nspotify:track:7GhIk7Il098yCjg4BQjzvb,Postman Track Two,Postman Test Quartet,Smoke Test Sessions,USPM00000002,2020-08-19,0.44,0.83,0.31,test-soul,188000\\nspotify:track:0VjIjW4GlUZAMYd2vXMi3b,Postman Track Three,Newman Ensemble,Smoke Test Sessions,USPM00000003,2023-02-02,0.87,0.50,0.78,test-electronic,234000\\nspotify:track:1mea3bSkSGXuIRvnydlB5b,Postman Track Four,Newman Ensemble,Smoke Test Sessions,USPM00000004,2019-11-30,0.36,0.71,0.60,test-folk,176000\",\"source_type\":\"liked\",\"source_name\":\"Postman Smoke Test\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/import/{{contributor_id}}"
      }
    },
    {
      "name": "06 Catalog shows imported tracks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var tracks = pm.response.json().tracks;",
              "pm.test('all 4 imported tracks appear in the catalog', function () {",
              "  pm.expect(tracks).to.have.lengthOf(4);",
              "  var names = tracks.map(function (t) { return t.name; });",
              "  pm.expect(names).to.include('Postman Track One');",
              "});",
              "pm.collectionVariables.set('track_ids', JSON.stringify(tracks.map(function (t) { return t.id; })));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tracks?contributor={{contributor_id}}"
      }
    },
    {
      "name": "07 Create playlist",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "var body = pm.response.json();",
              "pm.test('playlist created', function () {",
              "  pm.expect(body.ok).to.eql(true);",
              "  pm.expect(body.playlist.name).to.eql('Postman Smoke Playlist');",
              "});",
              "pm.collectionVariables.set('playlist_id', body.playlist.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cookie", "value": "{{session_cookie}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Smoke Playlist\",\n  \"description\": \"Created by the ourWKRP Postman collection\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/playlists"
      }
    },
    {
      "name": "08 Add tracks to playlist",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('4 tracks added', function () { pm.expect(pm.response.json().added).to.eql(4); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cookie", "value": "{{session_cookie}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"track_ids\": {{track_ids}} }",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/playlists/{{playlist_id}}/tracks"
      }
    },
    {
      "name": "09 Get playlist with tracks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('playlist persisted with all 4 tracks', function () {",
              "  pm.expect(body.playlist.id).to.eql(pm.collectionVariables.get('playlist_id'));",
              "  pm.expect(body.playlist.track_count).to.eql(4);",
              "  pm.expect(body.playlist.tracks).to.have.lengthOf(4);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/playlists/{{playlist_id}}"
      }
    },
    {
      "name": "10 Catalog stats",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var stats = pm.response.json().stats;",
              "pm.test('stats reflect the imported data', function () {",
              "  pm.expect(stats.total_tracks).to.be.at.least(4);",
              "  pm.expect(stats.total_playlists).to.be.at.least(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/stats"
      }
    },
    {
      "name": "11 Catalog page (HTML)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('serves HTML', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/catalog"
      }
    }
  ],
  "variable": [
    { "key": "session_cookie", "value": "" },
    { "key": "contributor_id", "value": "" },
    { "key": "playlist_id", "value": "" },
    { "key": "track_ids", "value": "[]" }
  ]
}
