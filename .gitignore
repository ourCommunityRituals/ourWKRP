__pycache__/
*.pyc

# Claude Code local settings (contains per-repo overrides)
.claude/settings.local.json

# Claude Code agent worktrees (local scratch, never committed)
.claude/worktrees/

# Editor / local-history artifacts
.history/
.vscode/

# Creator showcase (showcase/): real creator files are private, the work folder
# holds signed report links, the env file holds a throwaway local key, and the
# built pages and captures are published only by hand.
showcase/creators/*.json
showcase/work/
showcase/out/
showcase/.e2e/
showcase/lib/.mutants/
showcase/local-ose.env.json
showcase/test-results/
showcase/playwright-report/
